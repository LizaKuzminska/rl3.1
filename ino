#include <Arduino.h>

// ---------------- ПІНИ ----------------

// Кнопка 1 підключена до GPIO 12.
// Вона відповідає за зчитування датчика освітлення LDR.
const int btnReadLDR = 12; 

// Кнопка 2 підключена до GPIO 14.
// Вона відповідає за лічильник натискань і зміну LED.
const int btnCounter = 14; 

// LDR підключений до аналогового входу GPIO 34.
// Через analogRead() ми будемо зчитувати рівень освітлення.
const int ldrPin = 34; 

// Світлодіод підключений до GPIO 2.
const int ledPin = 2;  


// ---------------- ЗМІННІ ДЛЯ ПЕРЕРИВАНЬ ----------------

// volatile означає, що змінна може змінитися не тільки в loop(),
// а ще й у функції переривання.
// Тобто Arduino/ESP32 не буде її “оптимізовувати” неправильно.

volatile bool doReadLDR = false;
// Прапорець: якщо true — у loop() треба зчитати LDR.

volatile int pressCount = 0;
// Лічильник натискань другої кнопки.

volatile bool ledState = false;
// Стан світлодіода:
// false — вимкнений,
// true — увімкнений.

volatile bool updateLED = false;
// Прапорець: якщо true — у loop() треба оновити LED.


// ---------------- ПАРАМЕТРИ ШІМ ----------------

// Частота ШІМ — 5000 Гц.
// ШІМ потрібен для керування яскравістю світлодіода.
const int freq = 5000;

// Роздільна здатність 8 біт.
// Це означає, що яскравість може бути від 0 до 255.
const int resolution = 8; 


// ---------------- ОБРОБНИКИ ПЕРЕРИВАНЬ ----------------

// Ця функція викликається автоматично,
// коли спрацьовує переривання від кнопки 1.
void IRAM_ATTR handleLDR() {
  doReadLDR = true; 
  // Тут ми НЕ зчитуємо LDR одразу.
  // Ми просто ставимо прапорець true.
  // А саме зчитування буде вже в loop().
}

// Ця функція викликається автоматично,
// коли спрацьовує переривання від кнопки 2.
void IRAM_ATTR handleCounter() {
  pressCount++;
  // Збільшуємо кількість натискань на 1.

  ledState = !ledState;
  // Міняємо стан світлодіода на протилежний:
  // був вимкнений — стане увімкнений,
  // був увімкнений — стане вимкнений.

  updateLED = true;
  // Кажемо основній програмі, що треба оновити LED.
}


// ---------------- SETUP ----------------

void setup() {
  // Запускаємо Serial Monitor зі швидкістю 115200.
  // Така сама швидкість має бути вибрана в Serial Monitor.
  Serial.begin(115200);

  delay(1000); 
  // Невелика пауза, щоб Serial Monitor встиг запуститися.

  Serial.println("--- СИСТЕМА ЗАПУЩЕНА ---");
  Serial.println("Натисніть Кнопку 1 для LDR або Кнопку 2 для лічильника");

  // Налаштовуємо кнопки як входи з внутрішньою підтяжкою.
  // INPUT_PULLUP означає:
  // коли кнопка НЕ натиснута — на піні HIGH,
  // коли кнопка натиснута — на піні LOW.
  pinMode(btnReadLDR, INPUT_PULLUP);
  pinMode(btnCounter, INPUT_PULLUP);
  
  // Налаштовуємо ШІМ для світлодіода.
  // ledPin — пін світлодіода,
  // freq — частота,
  // resolution — роздільна здатність.
  ledcAttach(ledPin, freq, resolution);

  // Прив’язуємо переривання до кнопки 1.
  // RISING означає: переривання спрацює при переході з LOW у HIGH.
  attachInterrupt(digitalPinToInterrupt(btnReadLDR), handleLDR, RISING);

  // Прив’язуємо переривання до кнопки 2.
  // FALLING означає: переривання спрацює при переході з HIGH у LOW.
  // Для INPUT_PULLUP це зазвичай момент натискання кнопки.
  attachInterrupt(digitalPinToInterrupt(btnCounter), handleCounter, FALLING);
}


// ---------------- LOOP ----------------

void loop() {

  // ---------- ЛОГІКА КНОПКИ 1: ЗЧИТУВАННЯ LDR ----------

  if (doReadLDR) {
    // Якщо прапорець doReadLDR став true,
    // значить кнопка 1 спрацювала.

    int ldrValue = analogRead(ldrPin);
    // Зчитуємо значення з датчика освітлення.
    // На ESP32 analogRead зазвичай дає значення приблизно від 0 до 4095.

    Serial.print("Переривання 1: Значення LDR = ");
    Serial.println(ldrValue);
    // Виводимо значення освітлення в Serial Monitor.

    // Коротке мигнення світлодіода.
    ledcWrite(ledPin, 255);
    // Максимальна яскравість.

    delay(200);
    // Світлодіод горить 200 мс.

    ledcWrite(ledPin, 0);
    // Вимикаємо світлодіод.

    doReadLDR = false;
    // Скидаємо прапорець, щоб дія не повторювалася постійно.
  }


  // ---------- ЛОГІКА КНОПКИ 2: ЛІЧИЛЬНИК І ЯСКРАВІСТЬ ----------

  if (updateLED) {
    // Якщо updateLED true,
    // значить кнопка 2 була натиснута і треба змінити LED.

    if (ledState) {
      // Якщо ledState == true, світлодіод треба увімкнути.

      int brightness = (pressCount * 40) % 256; 
      // Розрахунок яскравості.
      // Кожне натискання збільшує pressCount.
      // pressCount множиться на 40.
      // % 256 не дає значенню вийти за межі 0–255.

      if (brightness < 10) brightness = 10;
      // Якщо яскравість вийшла дуже маленька,
      // ставимо мінімум 10, щоб світлодіод було видно.

      ledcWrite(ledPin, brightness);
      // Подаємо ШІМ-сигнал на світлодіод.
      // Чим більше brightness, тим яскравіше світить LED.

      Serial.print("Переривання 2: Натискань = ");
      Serial.print(pressCount);
      Serial.print(" | Стан: УВІМК | Яскравість: ");
      Serial.println(brightness);
    } 
    else {
      // Якщо ledState == false, світлодіод треба вимкнути.

      ledcWrite(ledPin, 0);
      // Яскравість 0 — світлодіод вимкнений.

      Serial.print("Переривання 2: Натискань = ");
      Serial.print(pressCount);
      Serial.println(" | Стан: ВИМКН");
    }

    updateLED = false;
    // Скидаємо прапорець, щоб ця дія не повторювалася без нового натискання.
  }
}
